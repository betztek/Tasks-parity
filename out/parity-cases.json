      "id": "roundtrip-due-scheduled-priority",
      "description": "Parse a task with due, scheduled and priority written in non-canonical order, and re-serialise it. Shows the field order Tasks writes.",
      "operation": "serialize-roundtrip",
      "today": "2026-11-14",
      "settings": {
        "globalFilter": "#task",
        "removeGlobalFilter": false,
        "taskFormat": "tasksPluginEmoji",
        "recurrenceOnNextLine": false,
        "removeScheduledDateOnRecurrence": false,
        "setCreatedDate": false,
        "setDoneDate": true,
        "setCancelledDate": true
      },
      "input": {
        "lines": [
          "- [ ] #task Submit expense report 📅 2026-11-20 ⏳ 2026-11-16 ⏫"
        ]
      },
      "expected": {
        "lines": [
          "- [ ] #task Submit expense report ⏫ ⏳ 2026-11-16 📅 2026-11-20"
        ],
        "tasks": [
          {
            "indentation": "",
            "listMarker": "-",
            "status": {
              "symbol": " ",
              "name": "Todo",
              "type": "TODO",
              "nextStatusSymbol": "x"
            },
            "description": "#task Submit expense report",
            "priority": "high",
            "dates": {
              "created": null,
              "start": null,
              "scheduled": "2026-11-16",
              "due": "2026-11-20",
              "done": null,
              "cancelled": null
            },
            "scheduledDateIsInferred": false,
            "recurrence": null,
            "onCompletion": "",
            "id": "",
            "dependsOn": [],
            "tags": [],
            "blockLink": ""
          }
        ]
      }
    },
